{
  "ConnectionStrings": {},
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Seq", "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "System": "Information",
        "Microsoft": "Information"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "Reyma.VectorSpace.Engine"
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "RollingFile",
              "Args": {
                "pathFormat": "api-{Date}.log",
                "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] ({Application}/{MachineName}/{ThreadId}) {Message:lj}{NewLine}{Exception} {Properties:j}"
              }
            }
          ]
        }
      },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://172.21.0.24:5341" }
      }
    ]
  },
  "AllowedHosts": "*",
  "IdentityServerAuthenticationOptions": {
    "Authority": "https://identity.innovacion.reyma.com.mx",
    "ApiName": "rym.vectorspace.engine.api",
    "RequireHttpsMetadata": true
  },
  "PermissionsValidatorOptions": {
    "ApiUri": "http://172.21.0.23:20000"
  },
  "IntegrityServiceOptions": {
    "ApiUri": "http://172.21.0.23:20001"
  },
  "ControlDeAcceso": {
    "Concesiones": []
  },
  "Motor": {
    "Git": {
      "OrigenesPermitidos": [
        {
          "Esquema": "https",
          "Host": "github.com",
          "Puerto": 443,
          "PrefijoRuta": "/DanielWueno/"
        }
      ]
    },
    "Embeddings": {
      "Perfiles": {
        "altheia-bge-m3-1024": {
          "UrlBase": "https://altheia",
          "Ruta": "v1/embeddings",
          "Modelo": "bge-m3",
          "Dimension": 1024,
          "PrefijoConsulta": ""
        }
      }
    },
    "Llm": {
      "UrlBase": "https://altheia",
      "Ruta": "v1/chat/completions",
      "Modelo": "qwen3.8-27b-fast",
      "MaxTokens": 160
    },
    "Resumen": {
      "PerfilEmbeddings": "altheia-bge-m3-1024",
      "TopeTokensPorCorrida": 50000
    }
  }
}
