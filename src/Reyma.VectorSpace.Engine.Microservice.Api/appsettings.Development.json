{
  "ConnectionStrings": {
    "Default": "User ID=vectorspace;Password=sin-uso;Host=localhost;Port=5432;Database=vectorspace;Pooling=true;ApplicationName=Reyma.VectorSpace.Engine;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Async",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "System": "Information",
        "Microsoft": "Information"
      }
    },
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"],
    "Properties": {
      "Application": "Reyma.VectorSpace.Engine.Dev",
      "Environment": "Development"
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "RollingFile",
              "Args": {
                "pathFormat": "api-{Date}.log",
                "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] ({Application}/{MachineName}/{ThreadId}) {Message:lj}{NewLine}{Exception} {Properties:j}"
              }
            }
          ]
        }
      },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://172.21.0.24:5341" }
      }
    ],
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "Contains(RequestPath, '/health')"
        }
      }
    ]
  },
  "IdentityServerAuthenticationOptions": {
    "Authority": "https://identity.innovacion.reyma.com.mx/auth/dev",
    "ApiName": "permissions.service.api",
    "RequireHttpsMetadata": true
  },
  "PermissionsValidatorOptions": {
    "ApiUri": "http://172.21.0.23:10000"
  },
  "IntegrityServiceOptions": {
    "ApiUri": "http://172.21.0.23:10001"
  },
  "Motor": {
    "Resumen": {
      "PerfilEmbeddings": "tei-arctic-256",
      "TopeTokensPorCorrida": 2147483647
    },
    "Qdrant": { "Host": "127.0.0.1", "PuertoGrpc": 6334 },
    "Embeddings": { "UrlBase": "http://127.0.0.1:8081" }
  },
  "ControlDeAcceso": {
    "Concesiones": [
      {
        "Coleccion": "prueba-propia",
        "Operaciones": [ "Consultar", "Ingestar" ],
        "Usuarios": [ "jdelgado" ]
      },
      {
        "Coleccion": "prueba-ajena",
        "Operaciones": [ "Consultar", "Ingestar" ],
        "Usuarios": [ "usuario.de.otro.tenant" ]
      }
    ]
  }
}
