<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <!-- Solo para probar por tipo que TransactionPipelineBehavior (item TransactionPipelineBehavior) ya no se registra. -->
    <PackageReference Include="Reyma.Mediator.Behaviors.Base.Postgres" Version="1.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Item 1.4: fixtures y golden master del chunking, copiados sin cambios de Rag.Context.Engine. -->
    <Content Include="Motor\Fixtures\*.fixture" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Motor\GoldenMaster\*.json" Link="GoldenMaster\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Reyma.VectorSpace.Engine.Microservice.Api\Reyma.VectorSpace.Engine.Microservice.Api.csproj" />
  </ItemGroup>

</Project>