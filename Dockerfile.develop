# syntax=docker/dockerfile:1
#
# Imagen de desarrollo del servicio (rama develop). Igual que el Dockerfile de
# produccion pero compila en Debug, corre en Development y publica bajo
# "<ruta base>/dev" para convivir con produccion en el mismo Ingress.
# Credenciales del feed (usuario/contrasena, item 1.5) usan BuildKit secrets
# y los placeholders %FEED_USERNAME%/%FEED_PASSWORD% de NuGet.Config; nunca
# se guardan en la imagen.

ARG BUILD_CONFIGURATION=Debug

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG BUILD_CONFIGURATION

# Certificado CA corporativo opcional (item 1.5): ver nota en el Dockerfile
# de produccion. Sin --secret id=corp-ca-cert,src=<ruta-local> este paso no
# monta nada y el build sigue igual que antes.
RUN --mount=type=secret,id=corp-ca-cert,target=/usr/local/share/ca-certificates/corp-ca.crt \
    if [ -s /usr/local/share/ca-certificates/corp-ca.crt ]; then update-ca-certificates; fi

WORKDIR /src
COPY ["NuGet.Config", "./"]
COPY ["src/", "src/"]

RUN --mount=type=secret,id=feed-username,env=FEED_USERNAME,required=true \
    --mount=type=secret,id=feed-password,env=FEED_PASSWORD,required=true \
    test -n "${FEED_USERNAME}" && test -n "${FEED_PASSWORD}" \
    && dotnet restore "src/Reyma.VectorSpace.Engine.Microservice.Api/Reyma.VectorSpace.Engine.Microservice.Api.csproj"
RUN dotnet publish "src/Reyma.VectorSpace.Engine.Microservice.Api/Reyma.VectorSpace.Engine.Microservice.Api.csproj" \
    -c "${BUILD_CONFIGURATION}" \
    -o /app/publish \
    --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final

ENV TZ=America/Mexico_City \
    ASPNETCORE_ENVIRONMENT=Development \
    ASPNETCORE_HTTP_PORTS=8080 \
    ASPNETCORE_BASEPATH=/reyma/vectorspace/engine/dev

RUN apt-get update \
    && apt-get install -y --no-install-recommends tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
EXPOSE 8080

USER app

COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "Reyma.VectorSpace.Engine.Microservice.Api.dll"]
