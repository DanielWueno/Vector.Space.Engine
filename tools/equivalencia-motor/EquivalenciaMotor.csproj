<Project Sdk="Microsoft.NET.Sdk">
  <!-- 1.4: herramienta de verificacion, no producto. Hospeda la API del servicio en proceso (identidad de prueba,
       motor real contra el Qdrant y el TEI de docker-compose.motor.yml), le envia por HTTP los documentos que el
       escaner REAL de Rag.Context.Engine (checkout hermano, solo lectura) encuentra en un repo, y compara los puntos
       resultantes con los que dejo el pipeline real de Rag.Context.Engine (Refragmentar). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RagContextEngineRoot Condition="'$(RagContextEngineRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\Rag.Context.Engine</RagContextEngineRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <ProjectReference Include="..\..\src\Reyma.VectorSpace.Engine.Microservice.Api\Reyma.VectorSpace.Engine.Microservice.Api.csproj" />
    <ProjectReference Include="$(RagContextEngineRoot)\src\RagEngine.Core\RagEngine.Core.csproj" />
  </ItemGroup>
</Project>
