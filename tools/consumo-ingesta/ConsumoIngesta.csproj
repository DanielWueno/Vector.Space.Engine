<Project Sdk="Microsoft.NET.Sdk">
  <!-- 1.7: herramienta de medicion, no producto. Hospeda la API del servicio en Kestrel real (identidad de prueba,
       motor real contra el Qdrant y el TEI que se le indiquen), le envia por HTTP los documentos que el escaner REAL de
       Rag.Context.Engine (checkout hermano, solo lectura) encuentra en un repo, y mide transferencia, tiempo, memoria,
       reintentos, concurrencia y saturacion. Ver README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RagContextEngineRoot Condition="'$(RagContextEngineRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\Rag.Context.Engine</RagContextEngineRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <ProjectReference Include="..\..\src\Reyma.VectorSpace.Engine.Microservice.Api\Reyma.VectorSpace.Engine.Microservice.Api.csproj" />
    <ProjectReference Include="$(RagContextEngineRoot)\src\RagEngine.Core\RagEngine.Core.csproj" />
  </ItemGroup>
</Project>
