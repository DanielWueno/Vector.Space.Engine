<Project Sdk="Microsoft.NET.Sdk">
  <!-- 1.11: herramienta de evaluacion, no producto. Corre el IIngestionPipeline REAL de
       Rag.Context.Engine (checkout hermano, solo lectura) con otro MaxTokensPerChunk. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RagContextEngineRoot Condition="'$(RagContextEngineRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\Rag.Context.Engine</RagContextEngineRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
    <ProjectReference Include="$(RagContextEngineRoot)\src\RagEngine.Core\RagEngine.Core.csproj" />
  </ItemGroup>
</Project>
